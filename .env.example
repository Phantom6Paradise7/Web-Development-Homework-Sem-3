# Shopease E-Commerce Environment Configuration Template

# Server Port (Render defaults to 10000; local dev uses 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/shopease_ecommerce
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopease?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopease_ecommerce

# Express Session Encryption Secret (Generate any random 32+ char string in production)
SESSION_SECRET=shopease_ultra_secure_session_secret_key_2026
