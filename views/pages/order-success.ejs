<div style="max-width: 760px; margin: 3rem auto;">
  <div class="card" style="padding: 3rem; text-align: center;">
    <!-- Animated Checkmark Circle -->
    <div style="width: 72px; height: 72px; background: #dcfce7; color: #16a34a; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2.2rem;">
      ✓
    </div>

    <span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: #16a34a; letter-spacing: 0.05em;">
      Payment Authorized & Confirmed
    </span>
    <h1 style="font-size: 2.25rem; font-weight: 800; margin: 0.5rem 0 1rem;">Thank you for your order!</h1>
    <p style="color: var(--text-secondary); font-size: 1rem; margin-bottom: 2rem;">
      We have received your order and our fulfillment team has begun processing your items for immediate dispatch.
    </p>

    <!-- Key Order Details Box -->
    <div style="background: var(--bg-muted); border-radius: var(--radius-lg); padding: 1.5rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: center; margin-bottom: 2.5rem;">
      <div>
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Order Number</div>
        <div style="font-size: 1.1rem; font-weight: 800; color: var(--primary); margin-top: 0.2rem;"><%= order.orderNumber %></div>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Estimated Delivery</div>
        <div style="font-size: 1rem; font-weight: 700; margin-top: 0.2rem;">
          <%= new Date(order.estimatedDelivery).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
        </div>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Total Paid</div>
        <div style="font-size: 1.1rem; font-weight: 800; color: #16a34a; margin-top: 0.2rem;">$<%= order.totalPrice.toFixed(2) %></div>
      </div>
    </div>

    <!-- Items Summary -->
    <div style="text-align: left; margin-bottom: 2.5rem;">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.5rem;">
        Items in This Order
      </h3>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% order.orderItems.forEach(item => { %>
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 56px; height: 56px; border-radius: var(--radius-md); object-fit: cover;">
              <div>
                <div style="font-weight: 700; font-size: 0.95rem;"><%= item.name %></div>
                <div style="font-size: 0.825rem; color: var(--text-muted);">Quantity: <%= item.quantity %></div>
              </div>
            </div>
            <div style="font-weight: 700; font-size: 1rem;">
              $<%= (item.price * item.quantity).toFixed(2) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Action Buttons -->
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/orders/<%= order._id %>" class="btn btn-primary btn-lg">
        Track Order Status &rarr;
      </a>
      <a href="/shop" class="btn btn-outline btn-lg">
        Continue Shopping
      </a>
    </div>
  </div>
</div>
