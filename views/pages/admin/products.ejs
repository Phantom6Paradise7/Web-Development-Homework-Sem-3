<div style="margin: 2rem 0 1.5rem; display: flex; justify-content: space-between; align-items: center;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">Product Inventory</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Manage catalog pricing, inventory levels, and merchandising badges.</p>
  </div>
  <a href="/admin/products/new" class="btn btn-primary">
    + Add New Product
  </a>
</div>

<div class="card" style="padding: 1.5rem; overflow-x: auto; margin-bottom: 3rem;">
  <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
    <thead>
      <tr style="border-bottom: 1.5px solid var(--border-subtle); text-align: left; color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase;">
        <th style="padding: 0.75rem 0.5rem; width: 60px;">Item</th>
        <th style="padding: 0.75rem 0.5rem;">Product Name</th>
        <th style="padding: 0.75rem 0.5rem;">Category</th>
        <th style="padding: 0.75rem 0.5rem;">Price</th>
        <th style="padding: 0.75rem 0.5rem;">Stock Level</th>
        <th style="padding: 0.75rem 0.5rem;">Ratings</th>
        <th style="padding: 0.75rem 0.5rem; text-align: right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <tr style="border-bottom: 1px solid var(--border-subtle);">
            <td style="padding: 0.75rem 0.5rem;">
              <img src="<%= product.thumbnail %>" alt="<%= product.name %>" style="width: 44px; height: 44px; border-radius: var(--radius-sm); object-fit: cover;">
            </td>
            <td style="padding: 0.75rem 0.5rem;">
              <a href="/product/<%= product.slug %>" target="_blank" style="font-weight: 700; color: var(--text-primary);">
                <%= product.name %>
              </a>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= product.brand %></div>
            </td>
            <td style="padding: 0.75rem 0.5rem; color: var(--text-secondary);">
              <%= product.category %>
            </td>
            <td style="padding: 0.75rem 0.5rem; font-weight: 700;">
              $<%= product.price.toFixed(2) %>
            </td>
            <td style="padding: 0.75rem 0.5rem;">
              <% if (product.stock > 10) { %>
                <span style="color: #16a34a; font-weight: 700; background: #dcfce7; padding: 0.2rem 0.55rem; border-radius: var(--radius-sm); font-size: 0.8rem;">
                  <%= product.stock %> in stock
                </span>
              <% } else if (product.stock > 0) { %>
                <span style="color: #ea580c; font-weight: 700; background: #ffedd5; padding: 0.2rem 0.55rem; border-radius: var(--radius-sm); font-size: 0.8rem;">
                  ⚠️ <%= product.stock %> left
                </span>
              <% } else { %>
                <span style="color: #dc2626; font-weight: 700; background: #fee2e2; padding: 0.2rem 0.55rem; border-radius: var(--radius-sm); font-size: 0.8rem;">
                  ✕ Sold Out
                </span>
              <% } %>
            </td>
            <td style="padding: 0.75rem 0.5rem;">
              ★ <%= product.ratings ? product.ratings.toFixed(1) : '5.0' %> (<%= product.numReviews || 0 %>)
            </td>
            <td style="padding: 0.75rem 0.5rem; text-align: right;">
              <div style="display: inline-flex; gap: 0.5rem;">
                <a href="/admin/products/<%= product._id %>/edit" class="btn btn-outline btn-sm">
                  Edit
                </a>
                <form action="/admin/products/<%= product._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                  <button type="submit" class="btn btn-outline btn-sm" style="color: var(--danger); border-color: var(--border-subtle);">
                    Delete
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">
            No products found. Click "+ Add New Product" to create your first listing.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
