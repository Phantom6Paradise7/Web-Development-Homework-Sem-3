<div style="margin: 2rem 0 1.5rem;">
  <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">Your Shopping Cart</h1>
  <p id="cartItemsSubtitle" style="color: var(--text-muted); font-size: 0.95rem;">
    Loading your saved bag...
  </p>
</div>

<!-- Dynamic LocalStorage Cart Container -->
<div id="cartViewRoot">
  <!-- Rendered dynamically by client-side ShopeaseCart script below -->
  <div style="text-align: center; padding: 4rem 2rem;">
    <div class="animate-spin" style="display: inline-block; width: 36px; height: 36px; border: 3px solid #e2e8f0; border-top-color: var(--primary); border-radius: 50%; margin-bottom: 1rem;"></div>
    <div style="color: var(--text-muted); font-weight: 600;">Loading your shopping cart...</div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  renderCartPage();

  window.addEventListener('shopease:cart-updated', function () {
    renderCartPage();
  });
});

function renderCartPage() {
  const root = document.getElementById('cartViewRoot');
  const subtitle = document.getElementById('cartItemsSubtitle');
  if (!root || !window.ShopeaseCart) return;

  const cart = window.ShopeaseCart.getCart();

  if (!cart.items || cart.items.length === 0) {
    if (subtitle) subtitle.textContent = '0 items in your bag';
    root.innerHTML = `
      <div style="background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: 5rem 2rem; text-align: center; margin: 2rem 0;">
        <div style="font-size: 4rem; margin-bottom: 1rem;">🛒</div>
        <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Your Cart is Empty</h2>
        <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2rem; max-width: 440px; margin-left: auto; margin-right: auto;">
          Looks like your shopping bag is empty. Browse our curated departments and discover your next favorite item!
        </p>
        <a href="/shop" class="btn btn-primary btn-lg">Start Shopping Now</a>
      </div>
    `;
    return;
  }

  const distinctCount = cart.items.length;
  if (subtitle) {
    subtitle.textContent = `${distinctCount} ${distinctCount === 1 ? 'distinct item' : 'distinct items'} (${cart.totalQty} total units) in your saved cart`;
  }

  root.innerHTML = `
    <div class="cart-layout">
      <!-- Items List -->
      <div>
        <div class="cart-table-card">
          ${cart.items.map(item => `
            <div class="cart-item-row" id="cart-row-${item.productId}">
              <a href="/product/${item.slug || ''}">
                <img src="${item.image}" alt="${item.name}" class="cart-item-img" onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800'">
              </a>

              <div class="cart-item-info">
                <a href="/product/${item.slug || ''}">
                  <h4>${item.name}</h4>
                </a>
                <div class="meta">
                  <span>Unit: $${Number(item.price).toFixed(2)}</span>
                  ${item.brand ? ` &bull; <span>${item.brand}</span>` : ''}
                </div>
              </div>

              <!-- Live Quantity Stepper -->
              <div class="quantity-stepper">
                <button type="button" class="stepper-btn" onclick="changeCartQty('${item.productId}', ${item.quantity - 1})" aria-label="Decrease">-</button>
                <input type="text" class="stepper-input" value="${item.quantity}" readonly>
                <button type="button" class="stepper-btn" onclick="changeCartQty('${item.productId}', ${item.quantity + 1})" aria-label="Increase">+</button>
              </div>

              <div style="font-weight: 800; font-size: 1.05rem; min-width: 90px; text-align: right;">
                $${(item.price * item.quantity).toFixed(2)}
              </div>

              <!-- Remove Item Button -->
              <button type="button" class="btn btn-outline btn-sm" onclick="removeCartItem('${item.productId}')" style="color: var(--danger); border-color: transparent;" title="Remove item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          `).join('')}
        </div>

        <!-- Action Row -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem;">
          <a href="/shop" class="btn btn-outline">
            &larr; Continue Shopping
          </a>
          <button type="button" class="btn btn-outline" onclick="clearFullCart()" style="color: var(--danger);">
            Clear Cart
          </button>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div>
        <div class="order-summary-card">
          <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 1.25rem;">Order Summary</h3>

          <div class="summary-row">
            <span>Items Subtotal (${cart.totalQty} items)</span>
            <strong>$${cart.subtotal.toFixed(2)}</strong>
          </div>

          <div class="summary-row">
            <span>Standard Shipping</span>
            ${cart.shipping === 0 
              ? '<strong style="color: var(--success);">FREE</strong>' 
              : `<strong>$${cart.shipping.toFixed(2)}</strong>`}
          </div>

          ${cart.shipping > 0 ? `
            <div style="background: var(--bg-muted); padding: 0.6rem 0.85rem; border-radius: var(--radius-md); font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 1rem;">
              Add <strong>$${(50 - cart.subtotal).toFixed(2)}</strong> more to qualify for <strong>FREE Express Shipping</strong>!
            </div>
          ` : ''}

          ${cart.discount > 0 ? `
            <div class="summary-row" style="color: #16a34a;">
              <span>Discount (${cart.coupon ? cart.coupon.code : 'Coupon'})</span>
              <strong>-$${cart.discount.toFixed(2)}</strong>
            </div>
          ` : ''}

          <!-- Coupon Box -->
          <div style="border-top: 1px solid var(--border-subtle); padding-top: 1rem; margin-top: 1rem;">
            ${cart.coupon ? `
              <div style="display: flex; justify-content: space-between; align-items: center; background: #ecfdf5; border: 1px dashed #10b981; padding: 0.5rem 0.85rem; border-radius: var(--radius-md); margin-bottom: 0.75rem;">
                <span style="font-size: 0.85rem; color: #065f46; font-weight: 700;">🎟️ ${cart.coupon.code} applied (${cart.coupon.value}% OFF)</span>
                <button type="button" onclick="removeCouponCode()" style="background: none; border: none; color: #dc2626; cursor: pointer; font-size: 0.75rem; font-weight: 700;">Remove</button>
              </div>
            ` : `
              <div class="coupon-form" style="display: flex; gap: 0.5rem; margin-bottom: 0.4rem;">
                <input type="text" id="cartCouponInput" placeholder="Enter coupon (e.g. SAVE20)" class="coupon-input" style="flex: 1; padding: 0.45rem 0.75rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 0.85rem; text-transform: uppercase;">
                <button type="button" onclick="submitCouponCode()" class="btn btn-secondary btn-sm">Apply</button>
              </div>
              <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">
                💡 Try code <strong>SAVE20</strong> (20% off) or <strong>WELCOME10</strong> (10% off)
              </div>
            `}
          </div>

          <div class="summary-row total" style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 800; border-top: 2px solid var(--border-subtle); padding-top: 1rem; margin-top: 0.5rem;">
            <span>Estimated Total</span>
            <span style="color: var(--primary);">$${cart.total.toFixed(2)}</span>
          </div>

          <button type="button" onclick="proceedToCheckout()" class="btn btn-primary btn-lg btn-block" id="checkoutBtn" style="margin-top: 1.5rem;">
            Proceed to Checkout &rarr;
          </button>

          <div style="margin-top: 1.25rem; font-size: 0.75rem; color: var(--text-muted); text-align: center; display: flex; flex-direction: column; gap: 0.35rem;">
            <span>🔒 Guaranteed Safe & Secure 256-Bit Encrypted Checkout</span>
            <span>🚚 Rapid 2-4 business day tracked delivery</span>
          </div>
        </div>
      </div>
    </div>
  `;
}

function changeCartQty(productId, newQty) {
  if (window.ShopeaseCart) {
    window.ShopeaseCart.updateQuantity(productId, newQty);
  }
}

function removeCartItem(productId) {
  if (window.ShopeaseCart) {
    window.ShopeaseCart.removeItem(productId);
    showToast('Item removed from cart', 'info');
  }
}

function clearFullCart() {
  if (confirm('Are you sure you want to clear your shopping cart?')) {
    if (window.ShopeaseCart) {
      window.ShopeaseCart.clearCart();
      showToast('Cart cleared', 'info');
    }
  }
}

function submitCouponCode() {
  const input = document.getElementById('cartCouponInput');
  if (!input || !input.value.trim()) return;
  const res = window.ShopeaseCart.applyCoupon(input.value.trim());
  if (res.success) {
    showToast(res.message, 'success');
  } else {
    showToast(res.message, 'error');
  }
}

function removeCouponCode() {
  if (window.ShopeaseCart) {
    window.ShopeaseCart.removeCoupon();
    showToast('Coupon removed', 'info');
  }
}

async function proceedToCheckout() {
  const btn = document.getElementById('checkoutBtn');
  if (btn) {
    btn.disabled = true;
    btn.textContent = 'Syncing Cart...';
  }

  // Sync LocalStorage cart with server session before navigating
  if (window.ShopeaseCart) {
    await window.ShopeaseCart.syncWithServer();
  }
  window.location.href = '/checkout';
}
</script>
