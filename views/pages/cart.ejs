<div style="margin: 2rem 0 1.5rem;">
  <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">Your Shopping Cart</h1>
  <p style="color: var(--text-muted); font-size: 0.95rem;">
    <%= cart.items.length %> <%= cart.items.length === 1 ? 'distinct item' : 'distinct items' %> in your bag
  </p>
</div>

<% if (cart && cart.items.length > 0) { %>
  <div class="cart-layout">
    <!-- Items Table / List -->
    <div>
      <div class="cart-table-card">
        <% cart.items.forEach(item => { %>
          <div class="cart-item-row" id="cart-row-<%= item.product %>">
            <a href="/product/<%= item.slug %>">
              <img src="<%= item.image %>" alt="<%= item.name %>" class="cart-item-img">
            </a>

            <div class="cart-item-info">
              <a href="/product/<%= item.slug %>">
                <h4><%= item.name %></h4>
              </a>
              <div class="meta">Unit Price: $<%= item.price.toFixed(2) %></div>
            </div>

            <!-- Quantity Stepper Form -->
            <form action="/cart/update" method="POST" style="display: flex; align-items: center;">
              <input type="hidden" name="productId" value="<%= item.product %>">
              <div class="quantity-stepper">
                <button type="submit" name="action" value="decrement" class="stepper-btn" aria-label="Decrease quantity">-</button>
                <input type="text" class="stepper-input" value="<%= item.quantity %>" readonly>
                <button type="submit" name="action" value="increment" class="stepper-btn" aria-label="Increase quantity">+</button>
              </div>
            </form>

            <div style="font-weight: 800; font-size: 1.05rem; min-width: 90px; text-align: right;">
              $<%= (item.price * item.quantity).toFixed(2) %>
            </div>

            <!-- Remove Button -->
            <form action="/cart/remove/<%= item.product %>" method="POST">
              <button type="submit" class="btn btn-outline btn-sm" style="color: var(--danger); border-color: transparent;" title="Remove Item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </form>
          </div>
        <% }) %>
      </div>

      <!-- Action buttons -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem;">
        <a href="/shop" class="btn btn-outline">
          &larr; Continue Shopping
        </a>
        <form action="/cart/clear" method="POST">
          <button type="submit" class="btn btn-outline" style="color: var(--danger);">
            Clear Cart
          </button>
        </form>
      </div>
    </div>

    <!-- Order Summary Sidebar -->
    <div>
      <div class="order-summary-card">
        <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 1.25rem;">Order Summary</h3>

        <div class="summary-row">
          <span>Items Subtotal (<%= cart.totalQty %> items)</span>
          <strong>$<%= cart.subtotal.toFixed(2) %></strong>
        </div>

        <div class="summary-row">
          <span>Standard Shipping</span>
          <% if (cart.shipping === 0) { %>
            <strong style="color: var(--success);">FREE</strong>
          <% } else { %>
            <strong>$<%= cart.shipping.toFixed(2) %></strong>
          <% } %>
        </div>

        <% if (cart.shipping > 0) { %>
          <div style="background: var(--bg-muted); padding: 0.6rem 0.85rem; border-radius: var(--radius-md); font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 1rem;">
            Add <strong>$<%= (50 - cart.subtotal).toFixed(2) %></strong> more of items to qualify for <strong>FREE Express Shipping</strong>!
          </div>
        <% } %>

        <% if (cart.discount > 0) { %>
          <div class="summary-row" style="color: #16a34a;">
            <span>Discount (<%= cart.coupon.code %>)</span>
            <strong>-$<%= cart.discount.toFixed(2) %></strong>
          </div>
        <% } %>

        <!-- Coupon Voucher Form -->
        <div style="border-top: 1px solid var(--border-subtle); padding-top: 1rem; margin-top: 1rem;">
          <% if (cart.coupon) { %>
            <div style="display: flex; justify-content: space-between; align-items: center; background: #ecfdf5; border: 1px dashed #10b981; padding: 0.5rem 0.85rem; border-radius: var(--radius-md); margin-bottom: 0.75rem;">
              <span style="font-size: 0.85rem; color: #065f46; font-weight: 700;">🎟️ <%= cart.coupon.code %> applied</span>
              <form action="/cart/coupon/remove" method="POST">
                <button type="submit" style="background: none; border: none; color: #dc2626; cursor: pointer; font-size: 0.75rem; font-weight: 600;">Remove</button>
              </form>
            </div>
          <% } else { %>
            <form action="/cart/coupon" method="POST" class="coupon-form">
              <input type="text" name="couponCode" placeholder="Enter coupon (e.g. SAVE20)" class="coupon-input" required>
              <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
            </form>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">
              💡 Try code <strong>SAVE20</strong> (20% off) or <strong>WELCOME10</strong> (10% off)
            </div>
          <% } %>
        </div>

        <div class="summary-row total">
          <span>Estimated Total</span>
          <span style="color: var(--primary);">$<%= cart.total.toFixed(2) %></span>
        </div>

        <a href="/checkout" class="btn btn-primary btn-lg btn-block" style="margin-top: 1.5rem;">
          Proceed to Checkout &rarr;
        </a>

        <div style="margin-top: 1.25rem; font-size: 0.75rem; color: var(--text-muted); text-align: center; display: flex; flex-direction: column; gap: 0.35rem;">
          <span>🔒 Guaranteed Safe & Secure 256-Bit Encrypted Checkout</span>
          <span>🚚 Rapid 2-4 business day tracked delivery</span>
        </div>
      </div>
    </div>
  </div>

<% } else { %>
  <!-- Empty Cart State -->
  <div style="background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: 5rem 2rem; text-align: center; margin: 3rem 0;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">🛒</div>
    <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Your Cart is Empty</h2>
    <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2rem; max-width: 440px; margin-left: auto; margin-right: auto;">
      Looks like you haven't added anything to your cart yet. Explore our curated collections to find something exceptional.
    </p>
    <a href="/shop" class="btn btn-primary btn-lg">Start Shopping Now</a>
  </div>
<% } %>
