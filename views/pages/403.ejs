<div style="max-width: 600px; margin: 5rem auto; text-align: center;">
  <div style="font-size: 5rem; font-weight: 800; color: #f59e0b; line-height: 1; margin-bottom: 1rem;">403</div>
  <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.75rem;">Access Restricted</h1>
  <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2rem;">
    <%= typeof message !== 'undefined' ? message : 'You do not have permission to view this merchant page.' %>
  </p>
  <div style="display: flex; gap: 1rem; justify-content: center;">
    <a href="/" class="btn btn-primary">Return to Storefront</a>
    <a href="/auth/login" class="btn btn-outline">Sign In as Admin</a>
  </div>
</div>
