<div style="margin: 2rem 0 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #0891b2;">Supplier Operations Center</span>
      <span style="font-size: 0.7rem; background: #dcfce7; color: #15803d; padding: 0.15rem 0.5rem; border-radius: var(--radius-sm); font-weight: 700;">✓ Verified Supplier</span>
    </div>
    <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;"><%= supplierName %></h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Manage real-time inventory levels, stock replenishments, and incoming supply orders.</p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/supplier/products/new" class="btn btn-primary btn-sm">+ List New Product</a>
    <a href="/supplier/products" class="btn btn-outline btn-sm">📦 Adjust Stock</a>
    <a href="/supplier/orders" class="btn btn-outline btn-sm">🚚 Orders</a>
  </div>
</div>

<!-- Supplier Metric Cards Grid -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2.5rem;">
  <div class="card" style="padding: 1.5rem; border-left: 4px solid #0891b2;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Catalog Listings</div>
    <div style="font-size: 2rem; font-weight: 800; margin-top: 0.25rem; color: var(--text-primary);"><%= totalProducts %></div>
    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Active catalog SKUs</div>
  </div>

  <div class="card" style="padding: 1.5rem; border-left: 4px solid #10b981;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Available Units in Warehouse</div>
    <div style="font-size: 2rem; font-weight: 800; margin-top: 0.25rem; color: var(--text-primary);"><%= totalStockUnits %></div>
    <div style="font-size: 0.75rem; color: #16a34a; margin-top: 0.25rem;">Across <%= inStockCount %> in-stock items</div>
  </div>

  <div class="card" style="padding: 1.5rem; border-left: 4px solid #f59e0b;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Low Stock Warnings</div>
    <div style="font-size: 2rem; font-weight: 800; margin-top: 0.25rem; color: #d97706;"><%= lowStockProducts.length %></div>
    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Items under 5 units</div>
  </div>

  <div class="card" style="padding: 1.5rem; border-left: 4px solid #6366f1;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Inventory Asset Value</div>
    <div style="font-size: 2rem; font-weight: 800; margin-top: 0.25rem; color: var(--text-primary);">$<%= totalInventoryValue %></div>
    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Gross inventory worth</div>
  </div>
</div>

<!-- Low Stock Immediate Action Box -->
<% if (lowStockProducts && lowStockProducts.length > 0) { %>
  <div class="alert alert-warning" style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <div style="font-size: 1.5rem;">⚠️</div>
      <div>
        <strong>Low Stock Alert:</strong> The following <%= lowStockProducts.length %> items require warehouse restocking:
        <span style="font-weight: 700; color: #92400e;">
          <%= lowStockProducts.map(p => `${p.name} (${p.stock} units)`).join(', ') %>
        </span>
      </div>
    </div>
    <a href="/supplier/products" class="btn btn-outline btn-sm" style="background: #fff; white-space: nowrap;">
      + Add Stock Now
    </a>
  </div>
<% } %>

<!-- Recent Supplier Orders -->
<div class="card" style="padding: 2rem; margin-bottom: 3rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
    <h3 style="font-size: 1.25rem; font-weight: 800;">Recent Fulfillment Orders</h3>
    <a href="/supplier/orders" style="color: var(--primary); font-weight: 600; font-size: 0.875rem;">View All Orders &rarr;</a>
  </div>

  <% if (recentOrders && recentOrders.length > 0) { %>
    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
      <thead>
        <tr style="border-bottom: 1.5px solid var(--border-subtle); text-align: left; color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase;">
          <th style="padding: 0.75rem 0.5rem;">Order #</th>
          <th style="padding: 0.75rem 0.5rem;">Customer</th>
          <th style="padding: 0.75rem 0.5rem;">Date</th>
          <th style="padding: 0.75rem 0.5rem;">Fulfillment</th>
          <th style="padding: 0.75rem 0.5rem; text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% recentOrders.forEach(o => { %>
          <tr style="border-bottom: 1px solid var(--border-subtle);">
            <td style="padding: 1rem 0.5rem; font-weight: 700; color: #0891b2;"><%= o.orderNumber %></td>
            <td style="padding: 1rem 0.5rem;">
              <div style="font-weight: 600;"><%= o.shippingAddress.fullName %></div>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= o.shippingAddress.city %>, <%= o.shippingAddress.state %></div>
            </td>
            <td style="padding: 1rem 0.5rem; color: var(--text-secondary);">
              <%= new Date(o.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
            </td>
            <td style="padding: 1rem 0.5rem;">
              <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: var(--radius-sm); background: <%= o.orderStatus === 'delivered' ? '#dcfce7' : (o.orderStatus === 'shipped' ? '#eff6ff' : '#fef3c7') %>; color: <%= o.orderStatus === 'delivered' ? '#15803d' : (o.orderStatus === 'shipped' ? '#1d4ed8' : '#b45309') %>;">
                <%= o.orderStatus %>
              </span>
            </td>
            <td style="padding: 1rem 0.5rem; text-align: right;">
              <a href="/supplier/orders" class="btn btn-outline btn-sm">Inspect Items</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">No customer orders placed for your catalog items yet.</p>
  <% } %>
</div>
