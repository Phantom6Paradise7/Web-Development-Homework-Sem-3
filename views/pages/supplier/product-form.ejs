<div style="max-width: 800px; margin: 2rem auto 3rem;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/supplier/products" style="color: var(--text-muted); font-size: 0.85rem;">&larr; Back to Inventory</a>
    <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; margin-top: 0.5rem;">
      <%= isEdit ? 'Edit Catalog Product' : 'List New Product for Sale' %>
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
      <%= isEdit ? 'Update product pricing, stock availability, and gallery photos.' : 'Publish a new item to the Shopease marketplace.' %>
    </p>
  </div>

  <div class="card" style="padding: 2.5rem 2rem;">
    <form action="<%= isEdit ? `/supplier/products/${product._id}/edit` : '/supplier/products/new' %>" method="POST">
      <!-- Title & Brand -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="prodName">Product Title *</label>
          <input type="text" name="name" id="prodName" class="form-control" required value="<%= product.name || '' %>" placeholder="e.g. Studio Pro Noise Cancelling Headphones">
        </div>
        <div class="form-group">
          <label class="form-label" for="prodBrand">Brand / Manufacturer *</label>
          <input type="text" name="brand" id="prodBrand" class="form-control" required value="<%= product.brand || '' %>" placeholder="e.g. Apex Acoustics">
        </div>
      </div>

      <!-- Category & Initial Stock Quantity -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="prodCat">Product Category *</label>
          <select name="category" id="prodCat" class="form-control" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.name %>" <%= product.category === cat.name ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="prodStock">Initial Warehouse Stock (Units) *</label>
          <input type="number" name="stock" id="prodStock" class="form-control" required min="0" value="<%= product.stock !== undefined ? product.stock : 25 %>">
          <span style="font-size: 0.75rem; color: var(--text-muted);">Stock can also be adjusted 1-click on the inventory dashboard</span>
        </div>
      </div>

      <!-- Pricing -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="prodPrice">Selling Price ($) *</label>
          <input type="number" step="0.01" name="price" id="prodPrice" class="form-control" required min="0" value="<%= product.price || '' %>" placeholder="89.99">
        </div>
        <div class="form-group">
          <label class="form-label" for="prodOrigPrice">Original / Compare Price ($)</label>
          <input type="number" step="0.01" name="originalPrice" id="prodOrigPrice" class="form-control" min="0" value="<%= product.originalPrice || '' %>" placeholder="119.99">
          <span style="font-size: 0.75rem; color: var(--text-muted);">Optional: shows strikethrough discount tag</span>
        </div>
      </div>

      <!-- Image URLs -->
      <div class="form-group">
        <label class="form-label" for="prodThumbnail">Primary Thumbnail Image URL *</label>
        <input type="url" name="thumbnail" id="prodThumbnail" class="form-control" required value="<%= product.thumbnail || '' %>" placeholder="https://images.unsplash.com/photo-...">
        <span style="font-size: 0.75rem; color: var(--text-muted);">High-definition photo link (Unsplash or CDN)</span>
      </div>

      <div class="form-group">
        <label class="form-label" for="prodImages">Additional Multi-Angle Photos (Comma separated URLs)</label>
        <input type="text" name="images" id="prodImages" class="form-control" value="<%= product.images ? product.images.join(', ') : '' %>" placeholder="https://image1.jpg, https://image2.jpg">
      </div>

      <!-- Merchandising Badge -->
      <div class="form-group">
        <label class="form-label" for="prodBadge">Merchandising Badge</label>
        <input type="text" name="badge" id="prodBadge" class="form-control" value="<%= product.badge || '' %>" placeholder="e.g. Best Seller, New Arrival, 20% OFF">
      </div>

      <!-- Key Features (One per line) -->
      <div class="form-group">
        <label class="form-label" for="prodFeatures">Key Highlights / Feature Bullets (One per line)</label>
        <textarea name="features" id="prodFeatures" rows="3" class="form-control" placeholder="Hybrid Active Noise Cancellation&#10;Up to 45 hours battery life&#10;High-grade memory foam cushions"><%= product.features ? (Array.isArray(product.features) ? product.features.join('\n') : product.features) : '' %></textarea>
      </div>

      <!-- Description -->
      <div class="form-group">
        <label class="form-label" for="prodDesc">Comprehensive Product Description *</label>
        <textarea name="description" id="prodDesc" rows="5" class="form-control" required placeholder="Detailed specifications, materials used, package contents, and warranty details..."><%= product.description || '' %></textarea>
      </div>

      <!-- Form Actions -->
      <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
        <a href="/supplier/products" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary" style="background: #0891b2;">
          <%= isEdit ? 'Update Listing' : 'Publish Product' %>
        </button>
      </div>
    </form>
  </div>
</div>
