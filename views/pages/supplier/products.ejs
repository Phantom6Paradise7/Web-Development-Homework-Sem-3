<div style="margin: 2rem 0 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #0891b2;">Supplier Warehouse Catalog</span>
      <span style="font-size: 0.75rem; background: var(--bg-muted); color: var(--text-secondary); padding: 0.15rem 0.5rem; border-radius: var(--radius-sm); font-weight: 600;">
        <%= products.length %> Active Listings
      </span>
    </div>
    <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">Stock & Inventory Management</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
      Quickly replenish or reduce warehouse stock levels using the 1-click controls below.
    </p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/supplier/products/new" class="btn btn-primary">
      + List New Product
    </a>
  </div>
</div>

<div class="card" style="padding: 1.5rem; overflow-x: auto; margin-bottom: 3rem;">
  <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;" id="supplierInventoryTable">
    <thead>
      <tr style="border-bottom: 1.5px solid var(--border-subtle); text-align: left; color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase;">
        <th style="padding: 0.75rem 0.5rem; width: 60px;">Item</th>
        <th style="padding: 0.75rem 0.5rem;">Product Details</th>
        <th style="padding: 0.75rem 0.5rem;">Category</th>
        <th style="padding: 0.75rem 0.5rem;">Unit Price</th>
        <th style="padding: 0.75rem 0.5rem;">Current Stock</th>
        <th style="padding: 0.75rem 0.5rem; min-width: 280px;">1-Click Stock Add / Remove</th>
        <th style="padding: 0.75rem 0.5rem; text-align: right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <tr style="border-bottom: 1px solid var(--border-subtle);" id="row-<%= product._id %>">
            <td style="padding: 1rem 0.5rem;">
              <img src="<%= product.thumbnail %>" alt="<%= product.name %>" style="width: 48px; height: 48px; border-radius: var(--radius-sm); object-fit: cover;">
            </td>
            <td style="padding: 1rem 0.5rem;">
              <a href="/product/<%= product.slug %>" target="_blank" style="font-weight: 700; color: var(--text-primary);">
                <%= product.name %>
              </a>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= product.brand %></div>
            </td>
            <td style="padding: 1rem 0.5rem; color: var(--text-secondary);">
              <span style="background: var(--bg-muted); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.8rem;">
                <%= product.category %>
              </span>
            </td>
            <td style="padding: 1rem 0.5rem; font-weight: 700;">
              $<%= product.price.toFixed(2) %>
            </td>

            <!-- Live Stock Level Badge -->
            <td style="padding: 1rem 0.5rem;">
              <div class="stock-status-pill-wrap" id="stock-badge-<%= product._id %>">
                <% if (product.stock > 10) { %>
                  <span class="stock-badge in-stock">
                    ✓ <span class="stock-num"><%= product.stock %></span> in stock
                  </span>
                <% } else if (product.stock > 0) { %>
                  <span class="stock-badge low-stock">
                    ⚠️ Only <span class="stock-num"><%= product.stock %></span> left
                  </span>
                <% } else { %>
                  <span class="stock-badge out-stock">
                    ✕ Sold Out (0)
                  </span>
                <% } %>
              </div>
            </td>

            <!-- Interactive Stock Add / Remove Widget -->
            <td style="padding: 1rem 0.5rem;">
              <div class="stock-action-widget" data-product-id="<%= product._id %>" data-endpoint="/supplier/products/<%= product._id %>/stock">
                <!-- Decrement / Remove Stock Buttons -->
                <div class="stock-btn-group remove-group">
                  <button type="button" class="btn-stock-adjust minus" data-action="remove" data-amount="1" title="Remove 1 unit">-1</button>
                  <button type="button" class="btn-stock-adjust minus" data-action="remove" data-amount="5" title="Remove 5 units">-5</button>
                  <button type="button" class="btn-stock-adjust minus" data-action="remove" data-amount="10" title="Remove 10 units">-10</button>
                </div>

                <!-- Custom Direct Input & Set Button -->
                <div class="stock-input-wrapper">
                  <input type="number" class="stock-direct-input" min="0" value="<%= product.stock %>" id="input-stock-<%= product._id %>">
                  <button type="button" class="btn-stock-set" data-action="set" title="Set exact stock count">Set</button>
                </div>

                <!-- Increment / Add Stock Buttons -->
                <div class="stock-btn-group add-group">
                  <button type="button" class="btn-stock-adjust plus" data-action="add" data-amount="1" title="Add 1 unit">+1</button>
                  <button type="button" class="btn-stock-adjust plus" data-action="add" data-amount="5" title="Add 5 units">+5</button>
                  <button type="button" class="btn-stock-adjust plus" data-action="add" data-amount="10" title="Add 10 units">+10</button>
                </div>
              </div>
            </td>

            <!-- Actions: Edit & Delete -->
            <td style="padding: 1rem 0.5rem; text-align: right;">
              <div style="display: inline-flex; gap: 0.5rem;">
                <a href="/supplier/products/<%= product._id %>/edit" class="btn btn-outline btn-sm">
                  Edit
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
            You have not listed any items in your inventory catalog yet. Click "+ List New Product" to start selling!
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
