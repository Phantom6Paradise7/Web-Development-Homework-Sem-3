<div style="max-width: 520px; margin: 3.5rem auto;">
  <!-- Role Portal Selector Tabs -->
  <div class="login-role-tabs" style="display: grid; grid-template-columns: repeat(4, 1fr);">
    <button type="button" class="login-role-tab active" id="tabCustomer" onclick="switchLoginRole('customer')">
      <span>👤 Customer</span>
    </button>
    <button type="button" class="login-role-tab" id="tabAdmin" onclick="switchLoginRole('admin')">
      <span>⚡ Admin</span>
    </button>
    <button type="button" class="login-role-tab" id="tabSupplier" onclick="switchLoginRole('supplier')">
      <span>🏭 Supplier</span>
    </button>
    <button type="button" class="login-role-tab" id="tabRider" onclick="switchLoginRole('rider')">
      <span>🛵 Rider</span>
    </button>
  </div>

  <div class="card" style="padding: 2.5rem 2rem; border-top-left-radius: 0; border-top-right-radius: 0;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div id="roleBadgeIcon" style="font-size: 2.2rem; margin-bottom: 0.5rem;">🛍️</div>
      <h1 id="loginHeaderTitle" style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;">Welcome Back</h1>
      <p id="loginHeaderDesc" style="color: var(--text-muted); font-size: 0.9rem;">
        Sign in to your customer account to track orders & save items
      </p>
    </div>

    <form action="/auth/login" method="POST" id="loginForm">
      <div class="form-group">
        <label class="form-label" for="loginEmail">Email Address</label>
        <input 
          type="email" 
          name="email" 
          id="loginEmail" 
          class="form-control" 
          placeholder="name@example.com" 
          required 
          value="<%= typeof email !== 'undefined' ? email : '' %>"
        >
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
          <label class="form-label" for="loginPassword" style="margin-bottom: 0;">Password</label>
        </div>
        <input 
          type="password" 
          name="password" 
          id="loginPassword" 
          class="form-control" 
          placeholder="••••••••" 
          required
        >
      </div>

      <button type="submit" id="loginSubmitBtn" class="btn btn-primary btn-lg btn-block" style="margin-top: 1rem;">
        Sign In as Customer
      </button>
    </form>

    <!-- Quick Demo Accounts Filler -->
    <div style="margin-top: 1.75rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
      <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; text-align: center; margin-bottom: 0.75rem;">
        ⚡ Instant 1-Click Demo Logins
      </div>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem;">
        <button 
          type="button" 
          class="btn btn-outline btn-sm" 
          onclick="fillCredentials('john@example.com', 'customer123', 'customer')"
          title="Login as Shopper"
          style="font-size: 0.75rem; padding: 0.4rem 0.2rem;"
        >
          👤 Shopper
        </button>
        <button 
          type="button" 
          class="btn btn-outline btn-sm" 
          onclick="fillCredentials('admin@store.com', 'admin123', 'admin')"
          title="Login as Store Administrator"
          style="font-size: 0.75rem; padding: 0.4rem 0.2rem;"
        >
          ⚡ Admin
        </button>
        <button 
          type="button" 
          class="btn btn-outline btn-sm" 
          onclick="fillCredentials('supplier@apex.com', 'supplier123', 'supplier')"
          title="Login as Verified Supplier"
          style="font-size: 0.75rem; padding: 0.4rem 0.2rem;"
        >
          🏭 Supplier
        </button>
        <button 
          type="button" 
          class="btn btn-outline btn-sm" 
          onclick="fillCredentials('rider@store.com', 'rider123', 'rider')"
          title="Login as Delivery Rider"
          style="font-size: 0.75rem; padding: 0.4rem 0.2rem; border-color: #059669; color: #059669;"
        >
          🛵 Rider
        </button>
      </div>
    </div>

    <div style="text-align: center; margin-top: 1.75rem; font-size: 0.875rem; color: var(--text-secondary);">
      Don't have an account? 
      <a href="/auth/register" id="registerLink" style="color: var(--primary); font-weight: 700;">
        Create Account
      </a>
      • 
      <a href="/auth/register?role=supplier" style="color: #06b6d4; font-weight: 700;">
        Become a Supplier
      </a>
    </div>
  </div>
</div>

<script>
function switchLoginRole(role) {
  document.querySelectorAll('.login-role-tab').forEach(t => t.classList.remove('active'));
  
  const headerTitle = document.getElementById('loginHeaderTitle');
  const headerDesc = document.getElementById('loginHeaderDesc');
  const badgeIcon = document.getElementById('roleBadgeIcon');
  const submitBtn = document.getElementById('loginSubmitBtn');
  
  if (role === 'customer') {
    document.getElementById('tabCustomer').classList.add('active');
    badgeIcon.textContent = '🛍️';
    headerTitle.textContent = 'Customer Sign In';
    headerDesc.textContent = 'Access your personal orders, wishlists, and express checkout.';
    submitBtn.textContent = 'Sign In to Customer Account';
    submitBtn.style.background = 'var(--primary)';
  } else if (role === 'admin') {
    document.getElementById('tabAdmin').classList.add('active');
    badgeIcon.textContent = '⚡';
    headerTitle.textContent = 'Administrator Console';
    headerDesc.textContent = 'Executive access to store analytics, orders, products & category studio.';
    submitBtn.textContent = 'Sign In to Admin Console';
    submitBtn.style.background = '#4338ca';
  } else if (role === 'supplier') {
    document.getElementById('tabSupplier').classList.add('active');
    badgeIcon.textContent = '🏭';
    headerTitle.textContent = 'Supplier & Vendor Portal';
    headerDesc.textContent = 'Manage your product inventory, stock levels, and supply orders.';
    submitBtn.textContent = 'Sign In to Supplier Portal';
    submitBtn.style.background = '#0891b2';
  } else if (role === 'rider') {
    document.getElementById('tabRider').classList.add('active');
    badgeIcon.textContent = '🛵';
    headerTitle.textContent = 'Delivery Rider Fleet Portal';
    headerDesc.textContent = 'Access assigned orders, accept pickups, update delivery status, and view routes.';
    submitBtn.textContent = 'Sign In to Rider Fleet Portal';
    submitBtn.style.background = '#059669';
  }
}

function fillCredentials(email, pass, role) {
  document.getElementById('loginEmail').value = email;
  document.getElementById('loginPassword').value = pass;
  if (role) {
    switchLoginRole(role);
  }
}
</script>
