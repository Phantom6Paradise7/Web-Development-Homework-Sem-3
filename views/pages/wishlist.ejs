<div style="margin: 2rem 0 1.5rem;">
  <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">My Saved Wishlist</h1>
  <p style="color: var(--text-muted); font-size: 0.95rem;">
    <%= wishlistItems.length %> <%= wishlistItems.length === 1 ? 'item' : 'items' %> saved for future shopping
  </p>
</div>

<% if (wishlistItems && wishlistItems.length > 0) { %>
  <div class="products-grid" style="margin-bottom: 3rem;">
    <% wishlistItems.forEach(product => { %>
      <div class="product-card">
        <div class="product-thumb-wrap">
          <a href="/product/<%= product.slug %>">
            <img src="<%= product.thumbnail %>" alt="<%= product.name %>">
          </a>

          <button 
            class="wishlist-toggle-btn active" 
            data-product-id="<%= product._id %>" 
            aria-label="Remove from wishlist"
            title="Remove from Wishlist"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </button>
        </div>

        <div class="product-card-body">
          <div class="product-meta">
            <span><%= product.category %></span>
            <span><%= product.brand %></span>
          </div>

          <a href="/product/<%= product.slug %>">
            <h3 class="product-title"><%= product.name %></h3>
          </a>

          <div class="product-pricing">
            <div class="current-price">$<%= product.price.toFixed(2) %></div>
            <% if (product.originalPrice && product.originalPrice > product.price) { %>
              <div class="original-price">$<%= product.originalPrice.toFixed(2) %></div>
            <% } %>
          </div>

          <button 
            class="btn btn-primary btn-sm btn-block ajax-add-cart-btn" 
            data-product-id="<%= product._id %>"
          >
            Move to Cart
          </button>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div style="background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: 5rem 2rem; text-align: center; margin: 3rem 0;">
    <div style="font-size: 3.5rem; margin-bottom: 1rem;">❤️</div>
    <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 0.5rem;">Your Wishlist is Empty</h3>
    <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 420px; margin-left: auto; margin-right: auto;">
      Click the heart icon on any product card or detail page to save items you want to keep track of.
    </p>
    <a href="/shop" class="btn btn-primary">Browse Trending Items</a>
  </div>
<% } %>
