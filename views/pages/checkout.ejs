<div style="margin: 2rem 0 1.5rem;">
  <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">Checkout & Shipping</h1>
  <p style="color: var(--text-muted); font-size: 0.95rem;">Please review your shipping details and select your preferred payment method.</p>
</div>

<form action="/checkout" method="POST">
  <div class="cart-layout">
    <!-- Left Column: Shipping & Payment -->
    <div>
      <!-- Shipping Address Box -->
      <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span>📍 1. Shipping Destination</span>
        </h3>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="fullName">Full Recipient Name *</label>
            <input 
              type="text" 
              name="fullName" 
              id="fullName" 
              class="form-control" 
              required 
              value="<%= savedAddress ? savedAddress.fullName : (currentUser ? currentUser.name : '') %>"
            >
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">Phone Number *</label>
            <input 
              type="tel" 
              name="phone" 
              id="phone" 
              class="form-control" 
              required 
              placeholder="+1 (555) 000-0000"
              value="<%= savedAddress ? savedAddress.phone : (currentUser && currentUser.phone ? currentUser.phone : '') %>"
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="street">Street Address *</label>
          <input 
            type="text" 
            name="street" 
            id="street" 
            class="form-control" 
            required 
            placeholder="House #, Street name, Apartment / Suite"
            value="<%= savedAddress ? savedAddress.street : '' %>"
          >
        </div>

        <div class="form-row-3">
          <div class="form-group">
            <label class="form-label" for="city">City *</label>
            <input 
              type="text" 
              name="city" 
              id="city" 
              class="form-control" 
              required 
              value="<%= savedAddress ? savedAddress.city : '' %>"
            >
          </div>
          <div class="form-group">
            <label class="form-label" for="state">State / Province *</label>
            <input 
              type="text" 
              name="state" 
              id="state" 
              class="form-control" 
              required 
              value="<%= savedAddress ? savedAddress.state : '' %>"
            >
          </div>
          <div class="form-group">
            <label class="form-label" for="postalCode">Postal Code / ZIP *</label>
            <input 
              type="text" 
              name="postalCode" 
              id="postalCode" 
              class="form-control" 
              required 
              value="<%= savedAddress ? savedAddress.postalCode : '' %>"
            >
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 0.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer;">
            <input type="checkbox" name="saveAddress" value="true" checked>
            <span>Save this address for fast checkout next time</span>
          </label>
        </div>
      </div>

      <!-- Payment Method Selection -->
      <div class="card" style="padding: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span>💳 2. Payment Method</span>
        </h3>

        <div class="payment-methods-grid">
          <label class="payment-method-card selected" id="labelCard">
            <input type="radio" name="paymentMethod" value="credit_card" checked style="display: none;" onchange="updatePaymentUI(this)">
            <div style="font-size: 1.75rem;">💳</div>
            <strong style="font-size: 0.9rem;">Credit / Debit Card</strong>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Visa, Mastercard, Amex</span>
          </label>

          <label class="payment-method-card" id="labelUpi">
            <input type="radio" name="paymentMethod" value="upi" style="display: none;" onchange="updatePaymentUI(this)">
            <div style="font-size: 1.75rem;">📱</div>
            <strong style="font-size: 0.9rem;">UPI / QR Pay</strong>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Instant Mobile App Pay</span>
          </label>

          <label class="payment-method-card" id="labelNet">
            <input type="radio" name="paymentMethod" value="net_banking" style="display: none;" onchange="updatePaymentUI(this)">
            <div style="font-size: 1.75rem;">🏦</div>
            <strong style="font-size: 0.9rem;">Net Banking</strong>
            <span style="font-size: 0.75rem; color: var(--text-muted);">All major bank portals</span>
          </label>

          <label class="payment-method-card" id="labelCod">
            <input type="radio" name="paymentMethod" value="cod" style="display: none;" onchange="updatePaymentUI(this)">
            <div style="font-size: 1.75rem;">💵</div>
            <strong style="font-size: 0.9rem;">Cash on Delivery</strong>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Pay cash upon delivery</span>
          </label>
        </div>

        <!-- Simulated Card Details (Shown for card) -->
        <div id="cardDetailsBlock" style="background: var(--bg-muted); border-radius: var(--radius-md); padding: 1.25rem;">
          <div class="form-group">
            <label class="form-label">Card Number</label>
            <input type="text" class="form-control" placeholder="•••• •••• •••• 4242" value="4242 •••• •••• 4242">
          </div>
          <div class="form-row">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Expiration Date</label>
              <input type="text" class="form-control" placeholder="MM/YY" value="12/28">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">CVV / CVC</label>
              <input type="password" class="form-control" placeholder="•••" value="888">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Order Review -->
    <div>
      <div class="order-summary-card">
        <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 1.25rem;">Order Review</h3>

        <div style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 260px; overflow-y: auto; margin-bottom: 1.25rem; padding-right: 0.5rem;">
          <% cart.items.forEach(item => { %>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 50px; height: 50px; border-radius: var(--radius-sm); object-fit: cover;">
              <div style="flex: 1; font-size: 0.85rem;">
                <div style="font-weight: 600; line-height: 1.2;"><%= item.name %></div>
                <div style="color: var(--text-muted);">Qty: <%= item.quantity %> × $<%= item.price.toFixed(2) %></div>
              </div>
              <div style="font-weight: 700; font-size: 0.9rem;">
                $<%= (item.price * item.quantity).toFixed(2) %>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="summary-row">
          <span>Items Subtotal</span>
          <strong>$<%= cart.subtotal.toFixed(2) %></strong>
        </div>

        <div class="summary-row">
          <span>Standard Shipping</span>
          <strong><%= cart.shipping === 0 ? 'FREE' : '$' + cart.shipping.toFixed(2) %></strong>
        </div>

        <% if (cart.discount > 0) { %>
          <div class="summary-row" style="color: #16a34a;">
            <span>Coupon Discount</span>
            <strong>-$<%= cart.discount.toFixed(2) %></strong>
          </div>
        <% } %>

        <div class="summary-row total">
          <span>Grand Total</span>
          <span style="color: var(--primary);">$<%= cart.total.toFixed(2) %></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block" style="margin-top: 1.5rem;">
          Place Order & Pay Now 🔒
        </button>

        <div style="margin-top: 1.25rem; font-size: 0.75rem; color: var(--text-muted); text-align: center;">
          By placing your order, you agree to Shopease's Terms of Service and Privacy Policy.
        </div>
      </div>
    </div>
  </div>
</form>

<script>
function updatePaymentUI(input) {
  document.querySelectorAll('.payment-method-card').forEach(card => card.classList.remove('selected'));
  input.closest('.payment-method-card').classList.add('selected');

  const cardBlock = document.getElementById('cardDetailsBlock');
  if (input.value === 'credit_card') {
    cardBlock.style.display = 'block';
  } else {
    cardBlock.style.display = 'none';
  }
}
</script>
