<!-- Hero Section -->
<section class="hero-section">
  <div class="hero-grid">
    <div>
      <div class="hero-pill">
        <span>✨ New 2026 Collection</span>
      </div>
      <h1 class="hero-title">
        Curated Essentials for <span>Modern Living.</span>
      </h1>
      <p class="hero-desc">
        Discover studio-grade acoustics, bespoke streetwear, ergonomic footwear, and minimalist home design crafted with uncompromised precision.
      </p>
      <div class="hero-buttons">
        <a href="/shop" class="btn btn-primary btn-lg">
          Explore Catalog
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/shop?category=Electronics" class="btn btn-outline btn-lg" style="color: #fff; border-color: rgba(255,255,255,0.3);">
          Featured Electronics
        </a>
      </div>
    </div>

    <div class="hero-preview-card">
      <% if (featuredProducts && featuredProducts.length > 0) { %>
        <img src="<%= featuredProducts[0].thumbnail %>" alt="<%= featuredProducts[0].name %>">
        <div style="text-align: left; margin-top: 0.75rem;">
          <span style="font-size: 0.75rem; text-transform: uppercase; color: #a5b4fc; font-weight: 700;">Spotlight Item</span>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin: 0.2rem 0;"><%= featuredProducts[0].name %></h3>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
            <span style="font-size: 1.35rem; font-weight: 800; color: #38bdf8;">$<%= featuredProducts[0].price.toFixed(2) %></span>
            <a href="/product/<%= featuredProducts[0].slug %>" class="btn btn-primary btn-sm">View Item</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Category Cards Grid -->
<section style="margin: 3.5rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;">Shop by Category</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Handpicked gear tailored to your daily pursuits</p>
    </div>
    <a href="/shop" style="color: var(--primary); font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 0.25rem;">
      Browse All Categories &rarr;
    </a>
  </div>

  <div class="categories-slider">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(cat => { %>
        <a href="/shop?category=<%= encodeURIComponent(cat.name) %>" class="category-card">
          <div class="category-icon-box">
            <% if (cat.slug === 'electronics') { %> 🎧
            <% } else if (cat.slug === 'fashion') { %> 👕
            <% } else if (cat.slug === 'footwear') { %> 👟
            <% } else if (cat.slug === 'home-living') { %> ☕
            <% } else { %> ⌚ <% } %>
          </div>
          <div class="category-info">
            <h4><%= cat.name %></h4>
            <p>Explore Catalog</p>
          </div>
        </a>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- Featured Best Sellers Grid -->
<section style="margin: 4rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;">Featured Best Sellers</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Top rated by our community of 50,000+ satisfied shoppers</p>
    </div>
    <a href="/shop" style="color: var(--primary); font-weight: 600; font-size: 0.9rem;">View All (<%= featuredProducts.length %>) &rarr;</a>
  </div>

  <div class="products-grid">
    <% if (featuredProducts && featuredProducts.length > 0) { %>
      <% featuredProducts.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- Promotional Deal Banner -->
<section style="background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%); border-radius: var(--radius-xl); padding: 3rem; color: #fff; margin: 4rem 0; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;">
  <div style="max-width: 580px;">
    <span style="background: rgba(255,255,255,0.2); padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">
      Limited Time Flash Deal
    </span>
    <h2 style="font-size: 2.25rem; font-weight: 800; margin: 0.75rem 0; line-height: 1.2;">
      Save Up To 25% On Studio Acoustics & Lifestyle Gear
    </h2>
    <p style="color: #e0e7ff; font-size: 1rem; margin-bottom: 1.5rem;">
      Use promotional voucher <strong>SAVE20</strong> at checkout for an extra 20% off all orders. Plus, unlock complimentary express priority courier dispatch!
    </p>
    <a href="/shop" class="btn btn-secondary btn-lg" style="background: #fff; color: #4338ca; box-shadow: 0 4px 14px rgba(0,0,0,0.15);">
      Claim Deal Now &rarr;
    </a>
  </div>
  <div style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); border-radius: var(--radius-lg); padding: 1.5rem; text-align: center; min-width: 220px;">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: #c7d2fe; font-weight: 700;">Coupon Code</div>
    <div style="font-size: 1.6rem; font-weight: 800; letter-spacing: 0.08em; margin: 0.5rem 0; color: #fff;">SAVE20</div>
    <div style="font-size: 0.75rem; color: #e0e7ff;">Auto-applied at checkout</div>
  </div>
</section>

<!-- Trending & New Arrivals Grid -->
<section style="margin: 4rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem;">
    <div>
      <h2 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;">Trending New Arrivals</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Fresh arrivals just landed in stock this week</p>
    </div>
    <a href="/shop?sort=newest" style="color: var(--primary); font-weight: 600; font-size: 0.9rem;">Explore Latest &rarr;</a>
  </div>

  <div class="products-grid">
    <% if (trendingProducts && trendingProducts.length > 0) { %>
      <% trendingProducts.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- Value Props / Perks Strip -->
<div class="perks-strip">
  <div class="perk-item">
    <div class="perk-icon">🚚</div>
    <div class="perk-text">
      <h5>Free Express Delivery</h5>
      <p>Complimentary over $50 orders</p>
    </div>
  </div>
  <div class="perk-item">
    <div class="perk-icon">🔒</div>
    <div class="perk-text">
      <h5>256-bit Secure Checkout</h5>
      <p>Card, UPI, Net Banking & COD</p>
    </div>
  </div>
  <div class="perk-item">
    <div class="perk-icon">↩️</div>
    <div class="perk-text">
      <h5>30-Day Hassle-Free Returns</h5>
      <p>No questions asked policy</p>
    </div>
  </div>
  <div class="perk-item">
    <div class="perk-icon">🎧</div>
    <div class="perk-text">
      <h5>24/7 Dedicated Support</h5>
      <p>Live human customer assistance</p>
    </div>
  </div>
</div>
