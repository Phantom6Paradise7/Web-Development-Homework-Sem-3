<!-- Hero Section -->
<section class="hero-section">
  <div class="hero-grid">
    <div>
      <div class="hero-pill">
        <span>✨ Spring 2026 Collection • Multi-Vendor Catalog</span>
      </div>
      <h1 class="hero-title">
        Curated Essentials for <span>Modern Living.</span>
      </h1>
      <p class="hero-desc">
        Discover studio-grade acoustics, bespoke streetwear, ergonomic footwear, and minimalist home design crafted with uncompromised precision by certified makers.
      </p>
      <div class="hero-buttons">
        <a href="/shop" class="btn btn-primary btn-lg">
          Explore All Products
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/shop?category=Electronics" class="btn btn-outline btn-lg" style="color: #fff; border-color: rgba(255,255,255,0.3);">
          Featured Electronics
        </a>
      </div>
    </div>

    <div class="hero-preview-card">
      <% if (featuredProducts && featuredProducts.length > 0) { %>
        <div style="position: relative; overflow: hidden; border-radius: var(--radius-md);">
          <img src="<%= featuredProducts[0].thumbnail %>" alt="<%= featuredProducts[0].name %>" style="width: 100%; height: 260px; object-fit: cover;">
          <div style="position: absolute; top: 0.75rem; right: 0.75rem; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: var(--radius-sm);">
            Verified Supplier
          </div>
        </div>
        <div style="text-align: left; margin-top: 0.75rem;">
          <span style="font-size: 0.75rem; text-transform: uppercase; color: #a5b4fc; font-weight: 700;">Spotlight Item</span>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin: 0.2rem 0;"><%= featuredProducts[0].name %></h3>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem;">
            <div>
              <span style="font-size: 1.35rem; font-weight: 800; color: #38bdf8;">$<%= featuredProducts[0].price.toFixed(2) %></span>
              <% if (featuredProducts[0].originalPrice > featuredProducts[0].price) { %>
                <span style="font-size: 0.85rem; text-decoration: line-through; color: #94a3b8; margin-left: 0.4rem;">$<%= featuredProducts[0].originalPrice.toFixed(2) %></span>
              <% } %>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button type="button" class="btn btn-outline btn-sm quick-view-btn" data-product-id="<%= featuredProducts[0]._id %>" style="color: #fff; border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.1);">
                Quick View
              </button>
              <a href="/product/<%= featuredProducts[0].slug %>" class="btn btn-primary btn-sm">Inspect</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Category Visual Grid (8 Categories) -->
<section style="margin: 4rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.5rem;">
    <div>
      <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--primary);">Curated Departments</span>
      <h2 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.02em;">Shop by Category</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Handpicked gear tailored to your daily pursuits</p>
    </div>
    <a href="/shop" style="color: var(--primary); font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 0.25rem;">
      Browse All Categories &rarr;
    </a>
  </div>

  <div class="categories-visual-grid">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(cat => { %>
        <a href="/shop?category=<%= encodeURIComponent(cat.name) %>" class="category-visual-card">
          <div class="cat-card-img-wrap">
            <img src="<%= cat.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600' %>" alt="<%= cat.name %>" loading="lazy">
            <div class="cat-card-overlay"></div>
          </div>
          <div class="cat-card-content">
            <div class="cat-card-icon"><%= cat.icon || '🏷️' %></div>
            <h3 class="cat-card-title"><%= cat.name %></h3>
            <span class="cat-card-count"><%= cat.itemCount || 0 %> items</span>
          </div>
        </a>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- Promotional Flash Deal Banner with Real-Time Countdown Timer -->
<section class="flash-deal-banner">
  <div class="flash-deal-info">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); padding: 0.3rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;">
      <span style="color: #fde047;">⚡ Flash Deal Ends In:</span>
      <div id="flashCountdown" class="countdown-timer-display" data-end-hours="8">
        <span class="timer-box"><b id="countHours">07</b>h</span> :
        <span class="timer-box"><b id="countMinutes">48</b>m</span> :
        <span class="timer-box"><b id="countSeconds">22</b>s</span>
      </div>
    </div>

    <h2 style="font-size: 2.25rem; font-weight: 800; margin: 1rem 0 0.5rem; line-height: 1.2;">
      Save 20% on Studio Acoustics & Tech Essentials
    </h2>
    <p style="color: #e0e7ff; font-size: 1rem; margin-bottom: 1.5rem; max-width: 540px;">
      Use promotional discount voucher <strong style="color: #fff; text-decoration: underline;">SAVE20</strong> at checkout for an instant 20% off all orders. Plus, unlock complimentary express priority courier dispatch!
    </p>

    <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
      <a href="/shop?category=Electronics" class="btn btn-secondary btn-lg" style="background: #fff; color: #4338ca; box-shadow: 0 4px 14px rgba(0,0,0,0.15); font-weight: 800;">
        Claim Flash Deal &rarr;
      </a>
      <span style="font-size: 0.85rem; color: #c7d2fe;">✓ Valid across all certified supplier items</span>
    </div>
  </div>

  <div class="flash-coupon-card">
    <div style="font-size: 0.8rem; text-transform: uppercase; color: #c7d2fe; font-weight: 700;">Promo Code</div>
    <div style="font-size: 1.8rem; font-weight: 800; letter-spacing: 0.08em; margin: 0.4rem 0; color: #fff;">SAVE20</div>
    <div style="font-size: 0.75rem; color: #e0e7ff; margin-bottom: 0.75rem;">Instant 20% Discount</div>
    <button type="button" class="btn btn-outline btn-sm" onclick="navigator.clipboard.writeText('SAVE20'); showToast('Coupon SAVE20 copied to clipboard!')" style="color: #fff; border-color: rgba(255,255,255,0.4); font-size: 0.75rem;">
      📋 Copy Code
    </button>
  </div>
</section>

<!-- Featured Best Sellers Grid -->
<section style="margin: 4rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.5rem;">
    <div>
      <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--primary);">Community Favorites</span>
      <h2 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.02em;">Featured Best Sellers</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Top rated by our community of 50,000+ satisfied shoppers</p>
    </div>
    <a href="/shop" style="color: var(--primary); font-weight: 600; font-size: 0.9rem;">View All Catalog &rarr;</a>
  </div>

  <div class="products-grid">
    <% if (featuredProducts && featuredProducts.length > 0) { %>
      <% featuredProducts.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- Trending & New Arrivals Grid -->
<section style="margin: 4rem 0;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.5rem;">
    <div>
      <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--primary);">Fresh Inventory</span>
      <h2 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.02em;">Trending New Arrivals</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Recently replenished warehouse stock just landed this week</p>
    </div>
    <a href="/shop?sort=newest" style="color: var(--primary); font-weight: 600; font-size: 0.9rem;">Explore Latest &rarr;</a>
  </div>

  <div class="products-grid">
    <% if (trendingProducts && trendingProducts.length > 0) { %>
      <% trendingProducts.forEach(product => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- Recently Viewed Products Container (Populated via LocalStorage) -->
<section id="recentlyViewedSection" style="display: none; margin: 4rem 0;">
  <div style="margin-bottom: 1.5rem;">
    <h3 style="font-size: 1.4rem; font-weight: 800;">Recently Viewed Products</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem;">Pick up where you left off</p>
  </div>
  <div class="products-grid" id="recentlyViewedGrid"></div>
</section>

<!-- Value Props / Perks Strip -->
<div class="perks-strip">
  <div class="perk-item">
    <div class="perk-icon">🚚</div>
    <div class="perk-text">
      <h5>Free Express Delivery</h5>
      <p>Complimentary over $50 orders</p>
    </div>
  </div>
  <div class="perk-item">
    <div class="perk-icon">🔒</div>
    <div class="perk-text">
      <h5>256-bit Secure Checkout</h5>
      <p>Cards, COD, Apple Pay & Klarna</p>
    </div>
  </div>
  <div class="perk-item">
    <div class="perk-icon">🏭</div>
    <div class="perk-text">
      <h5>Certified Suppliers</h5>
      <p>100% verified merchant partners</p>
    </div>
  </div>
  <div class="perk-item">
    <div class="perk-icon">↩️</div>
    <div class="perk-text">
      <h5>30-Day Hassle-Free Returns</h5>
      <p>Zero risk with prepaid return label</p>
    </div>
  </div>
</div>
