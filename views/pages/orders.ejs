<div style="margin: 2rem 0 1.5rem;">
  <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">My Orders</h1>
  <p style="color: var(--text-muted); font-size: 0.95rem;">Track, manage, and review all your purchases with live shipping updates.</p>
</div>

<% if (orders && orders.length > 0) { %>
  <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 3rem;">
    <% orders.forEach(order => { %>
      <div class="card" style="padding: 1.75rem;">
        <!-- Header Strip -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem;">
          <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Order Placed</div>
            <div style="font-weight: 600; font-size: 0.95rem;">
              <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
            </div>
          </div>
          <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Total Amount</div>
            <div style="font-weight: 700; font-size: 0.95rem;">$<%= order.totalPrice.toFixed(2) %></div>
          </div>
          <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Order ID</div>
            <div style="font-weight: 700; font-size: 0.95rem; color: var(--primary);"><%= order.orderNumber %></div>
          </div>
          <div>
            <% if (order.orderStatus === 'delivered') { %>
              <span style="background: #dcfce7; color: #15803d; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 700;">
                ✓ Delivered
              </span>
            <% } else if (order.orderStatus === 'shipped') { %>
              <span style="background: #eff6ff; color: #1d4ed8; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 700;">
                🚚 In Transit / Shipped
              </span>
            <% } else if (order.orderStatus === 'processing') { %>
              <span style="background: #fef3c7; color: #b45309; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 700;">
                ⏳ Processing
              </span>
            <% } else { %>
              <span style="background: var(--bg-muted); color: var(--text-secondary); padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.8rem; font-weight: 700;">
                ● Order Placed
              </span>
            <% } %>
          </div>
        </div>

        <!-- Items preview -->
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <% order.orderItems.forEach(item => { %>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 54px; height: 54px; border-radius: var(--radius-md); object-fit: cover; border: 1px solid var(--border-subtle);">
                <div>
                  <div style="font-weight: 600; font-size: 0.9rem;"><%= item.name %></div>
                  <div style="font-size: 0.8rem; color: var(--text-muted);">Qty: <%= item.quantity %> • $<%= item.price.toFixed(2) %></div>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Actions -->
          <div style="display: flex; gap: 0.75rem;">
            <a href="/orders/<%= order._id %>" class="btn btn-primary btn-sm">
              View & Track Order &rarr;
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div style="background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: 4rem 2rem; text-align: center; margin: 3rem 0;">
    <div style="font-size: 3.5rem; margin-bottom: 1rem;">📦</div>
    <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 0.5rem;">No orders found</h3>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">You haven't made any purchases yet. Your order history and live parcel updates will appear here.</p>
    <a href="/shop" class="btn btn-primary">Start Exploring Products</a>
  </div>
<% } %>
