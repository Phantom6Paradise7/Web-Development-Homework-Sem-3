<div style="margin: 2rem 0 1rem;">
  <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.02em;">
    <% if (activeFilters.category && activeFilters.category !== 'all') { %>
      <%= activeFilters.category %> Collection
    <% } else if (activeFilters.q) { %>
      Search results for "<%= activeFilters.q %>"
    <% } else { %>
      Explore All Products
    <% } %>
  </h1>
  <p style="color: var(--text-muted); font-size: 0.95rem;">
    Showing <%= products.length %> of <%= totalProducts %> items available in stock
  </p>
</div>

<div class="shop-layout">
  <!-- Filter Sidebar -->
  <aside class="filter-sidebar">
    <form action="/shop" method="GET" id="filterForm">
      <% if (activeFilters.q) { %>
        <input type="hidden" name="q" value="<%= activeFilters.q %>">
      <% } %>

      <!-- Categories Filter -->
      <div class="filter-group">
        <div class="filter-heading">
          <span>Categories</span>
        </div>
        <div class="filter-options">
          <label class="filter-radio-label">
            <input 
              type="radio" 
              name="category" 
              value="all" 
              <%= !activeFilters.category || activeFilters.category === 'all' ? 'checked' : '' %>
              onchange="document.getElementById('filterForm').submit()"
            >
            <span>All Categories</span>
          </label>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <label class="filter-radio-label">
                <input 
                  type="radio" 
                  name="category" 
                  value="<%= cat.name %>" 
                  <%= activeFilters.category && activeFilters.category.toLowerCase() === cat.name.toLowerCase() ? 'checked' : '' %>
                  onchange="document.getElementById('filterForm').submit()"
                >
                <span><%= cat.name %></span>
              </label>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Price Range Filter -->
      <div class="filter-group">
        <div class="filter-heading">
          <span>Price Range ($)</span>
        </div>
        <div class="price-inputs">
          <input type="number" name="minPrice" placeholder="Min" value="<%= activeFilters.minPrice %>" min="0">
          <span style="color: var(--text-muted);">-</span>
          <input type="number" name="maxPrice" placeholder="Max" value="<%= activeFilters.maxPrice %>" min="0">
        </div>
        <button type="submit" class="btn btn-outline btn-sm btn-block">Apply Price</button>
      </div>

      <!-- Brand Filter -->
      <% if (brands && brands.length > 0) { %>
        <div class="filter-group">
          <div class="filter-heading">
            <span>Brands</span>
          </div>
          <div class="filter-options">
            <label class="filter-radio-label">
              <input 
                type="radio" 
                name="brand" 
                value="all" 
                <%= !activeFilters.brand || activeFilters.brand === 'all' ? 'checked' : '' %>
                onchange="document.getElementById('filterForm').submit()"
              >
              <span>All Brands</span>
            </label>
            <% brands.forEach(b => { %>
              <label class="filter-radio-label">
                <input 
                  type="radio" 
                  name="brand" 
                  value="<%= b %>" 
                  <%= activeFilters.brand === b ? 'checked' : '' %>
                  onchange="document.getElementById('filterForm').submit()"
                >
                <span><%= b %></span>
              </label>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Rating Filter -->
      <div class="filter-group">
        <div class="filter-heading">
          <span>Customer Rating</span>
        </div>
        <div class="filter-options">
          <label class="filter-radio-label">
            <input 
              type="radio" 
              name="rating" 
              value="" 
              <%= !activeFilters.rating ? 'checked' : '' %>
              onchange="document.getElementById('filterForm').submit()"
            >
            <span>Any Rating</span>
          </label>
          <label class="filter-radio-label">
            <input 
              type="radio" 
              name="rating" 
              value="4.5" 
              <%= activeFilters.rating === '4.5' ? 'checked' : '' %>
              onchange="document.getElementById('filterForm').submit()"
            >
            <span>★ 4.5 & up</span>
          </label>
          <label class="filter-radio-label">
            <input 
              type="radio" 
              name="rating" 
              value="4" 
              <%= activeFilters.rating === '4' ? 'checked' : '' %>
              onchange="document.getElementById('filterForm').submit()"
            >
            <span>★ 4.0 & up</span>
          </label>
        </div>
      </div>

      <!-- Clear Filters -->
      <a href="/shop" class="btn btn-outline btn-sm btn-block" style="color: var(--text-muted);">
        Reset All Filters
      </a>
    </form>
  </aside>

  <!-- Products Main Content -->
  <section>
    <!-- Top Bar with sorting -->
    <div class="shop-top-bar">
      <div style="font-size: 0.875rem; color: var(--text-secondary); font-weight: 600;">
        <% if (activeFilters.category && activeFilters.category !== 'all') { %>
          <span style="background: var(--primary-light); color: var(--primary); padding: 0.2rem 0.6rem; border-radius: var(--radius-sm); margin-right: 0.5rem;">
            <%= activeFilters.category %>
          </span>
        <% } %>
        <span>Showing <%= products.length %> items</span>
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <label for="sortSelect" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);">Sort By:</label>
        <select 
          id="sortSelect" 
          class="sort-select" 
          onchange="
            const url = new URL(window.location.href);
            url.searchParams.set('sort', this.value);
            window.location.href = url.toString();
          "
        >
          <option value="newest" <%= activeFilters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="price-asc" <%= activeFilters.sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price-desc" <%= activeFilters.sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="rating" <%= activeFilters.sort === 'rating' ? 'selected' : '' %>>Highest Rated</option>
          <option value="popular" <%= activeFilters.sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <% if (products && products.length > 0) { %>
      <div class="products-grid">
        <% products.forEach(product => { %>
          <%- include('../partials/product-card', { product }) %>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <nav class="pagination" aria-label="Catalog pagination">
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a 
              href="/shop?page=<%= i %>&category=<%= activeFilters.category %>&sort=<%= activeFilters.sort %>&minPrice=<%= activeFilters.minPrice %>&maxPrice=<%= activeFilters.maxPrice %>&q=<%= activeFilters.q %>"
              class="page-link <%= currentPage === i ? 'active' : '' %>"
            >
              <%= i %>
            </a>
          <% } %>
        </nav>
      <% } %>

    <% } else { %>
      <div style="background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 4rem 2rem; text-align: center; margin: 2rem 0;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
        <h3 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem;">No products found</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem; max-width: 420px; margin-left: auto; margin-right: auto;">
          We couldn't find any products matching your active filters or search terms. Try loosening your criteria or resetting your search.
        </p>
        <a href="/shop" class="btn btn-primary">Browse All Catalog</a>
      </div>
    <% } %>
  </section>
</div>
