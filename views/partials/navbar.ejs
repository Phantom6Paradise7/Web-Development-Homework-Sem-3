<header class="site-header">
  <div class="container">
    <div class="nav-main">
      <!-- Logo -->
      <a href="/" class="brand-logo">
        <div class="brand-icon">🛍️</div>
        <span>Shopease</span>
      </a>

      <!-- Search Bar -->
      <div class="header-search-wrapper">
        <form action="/shop" method="GET" class="search-form">
          <button type="submit" class="search-icon-btn" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <input 
            type="text" 
            name="q" 
            id="mainSearchInput" 
            class="search-input" 
            placeholder="Search audio, fashion, sneakers, accessories..." 
            value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>"
            autocomplete="off"
          >
        </form>
        <div class="search-dropdown-results" id="searchDropdownResults"></div>
      </div>

      <!-- Nav Actions -->
      <div class="nav-actions">
        <!-- Explore Shop Link -->
        <a href="/shop" class="nav-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Explore</span>
        </a>

        <!-- Wishlist -->
        <a href="/wishlist" class="nav-btn" aria-label="Wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span>Saved</span>
          <% if (typeof wishlistCount !== 'undefined' && wishlistCount > 0) { %>
            <span class="badge-counter wishlist-count-badge"><%= wishlistCount %></span>
          <% } %>
        </a>

        <!-- Cart -->
        <a href="/cart" class="nav-btn" aria-label="Shopping Cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span>Cart</span>
          <span class="badge-counter cart-count-badge"><%= typeof cart !== 'undefined' ? cart.totalQty : 0 %></span>
        </a>

        <!-- User Menu / Sign In -->
        <% if (currentUser) { %>
          <div class="user-menu-dropdown">
            <button class="nav-btn" style="background: var(--bg-muted); cursor: pointer; border: none;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span><%= currentUser.name.split(' ')[0] %></span>
              <% if (currentUser.role === 'admin') { %>
                <span style="background: #4f46e5; color: #fff; font-size: 0.65rem; padding: 0.1rem 0.35rem; border-radius: 4px; font-weight: 700;">Admin</span>
              <% } else if (currentUser.role === 'supplier') { %>
                <span style="background: #0891b2; color: #fff; font-size: 0.65rem; padding: 0.1rem 0.35rem; border-radius: 4px; font-weight: 700;">Supplier</span>
              <% } %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="dropdown-menu">
              <% if (currentUser.role === 'admin') { %>
                <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; padding: 0.4rem 1rem;">
                  Admin Control
                </div>
                <a href="/admin" class="dropdown-item" style="color: var(--primary); font-weight: 700;">
                  ⚡ Executive Dashboard
                </a>
                <a href="/admin/products" class="dropdown-item">
                  📦 Inventory & Stock
                </a>
                <a href="/admin/categories" class="dropdown-item">
                  🏷️ Category Studio
                </a>
                <a href="/admin/suppliers" class="dropdown-item">
                  🤝 Supplier Directory
                </a>
                <a href="/admin/orders" class="dropdown-item">
                  🚚 Customer Orders
                </a>
                <div class="dropdown-divider"></div>
              <% } else if (currentUser.role === 'supplier') { %>
                <div style="font-size: 0.7rem; text-transform: uppercase; color: #0891b2; font-weight: 800; padding: 0.4rem 1rem;">
                  Supplier Portal
                </div>
                <a href="/supplier" class="dropdown-item" style="color: #0891b2; font-weight: 700;">
                  🏭 Operations Dashboard
                </a>
                <a href="/supplier/products" class="dropdown-item">
                  📦 Manage Stock Levels
                </a>
                <a href="/supplier/products/new" class="dropdown-item">
                  ➕ List New Product
                </a>
                <a href="/supplier/orders" class="dropdown-item">
                  🚚 Fulfillment Orders
                </a>
                <div class="dropdown-divider"></div>
              <% } %>
              <a href="/orders" class="dropdown-item">📦 My Orders</a>
              <a href="/wishlist" class="dropdown-item">❤️ Saved Wishlist</a>
              <a href="/profile" class="dropdown-item">⚙️ Account Profile</a>
              <div class="dropdown-divider"></div>
              <a href="/auth/logout" class="dropdown-item" style="color: var(--danger);">🚪 Sign Out</a>
            </div>
          </div>
        <% } else { %>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <a href="/auth/login" class="btn btn-primary btn-sm">
              Sign In
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sub navigation with Categories -->
  <div class="sub-nav">
    <div class="container">
      <div class="sub-nav-inner">
        <div class="sub-nav-links">
          <a href="/shop" class="sub-nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/shop' && (!query || !query.category || query.category === 'all') ? 'active' : '' %>">
            🔥 All Products
          </a>
          <% if (typeof navCategories !== 'undefined') { %>
            <% navCategories.forEach(cat => { %>
              <a href="/shop?category=<%= encodeURIComponent(cat.name) %>" class="sub-nav-link <%= typeof query !== 'undefined' && query.category && query.category.toLowerCase() === cat.name.toLowerCase() ? 'active' : '' %>">
                <span><%= cat.icon || '🏷️' %></span> <%= cat.name %>
              </a>
            <% }) %>
          <% } %>
        </div>
        <div style="font-size: 0.8rem; font-weight: 600; color: #10b981; display: flex; align-items: center; gap: 0.3rem;">
          <span>⚡ Instant 1-Day Dispatch</span>
        </div>
      </div>
    </div>
  </div>
</header>
