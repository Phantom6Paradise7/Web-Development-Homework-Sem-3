<div class="product-card" data-product-id="<%= product._id %>">
  <div class="product-thumb-wrap">
    <a href="/product/<%= product.slug %>" class="thumb-link">
      <img src="<%= product.thumbnail %>" alt="<%= product.name %>" class="primary-img" loading="lazy">
      <% if (product.images && product.images.length > 1) { %>
        <img src="<%= product.images[1] %>" alt="<%= product.name %> alternate view" class="secondary-img" loading="lazy">
      <% } %>
    </a>

    <!-- Badges -->
    <div class="product-badges-stack">
      <% if (product.badge) { %>
        <div class="product-badge"><%= product.badge %></div>
      <% } %>
      <% if (product.discountPercent > 0) { %>
        <div class="product-badge discount">-<%= product.discountPercent %>%</div>
      <% } %>
    </div>

    <!-- Stock Status Pill (Overlay on image bottom) -->
    <div class="card-stock-pill-wrap">
      <% if (product.stock > 10) { %>
        <span class="stock-pill in-stock">● In Stock</span>
      <% } else if (product.stock > 0) { %>
        <span class="stock-pill low-stock">⚠️ Only <%= product.stock %> left</span>
      <% } else { %>
        <span class="stock-pill out-stock">✕ Sold Out</span>
      <% } %>
    </div>

    <!-- Quick View Trigger Button (Floats on hover) -->
    <button 
      type="button" 
      class="quick-view-btn" 
      data-product-id="<%= product._id %>" 
      title="Quick View"
      aria-label="Quick View <%= product.name %>"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <span>Quick View</span>
    </button>

    <!-- Wishlist Heart Button -->
    <button 
      class="wishlist-toggle-btn" 
      data-product-id="<%= product._id %>" 
      aria-label="Save to wishlist"
      title="Save to Wishlist"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>
  </div>

  <div class="product-card-body">
    <div class="product-meta">
      <span><%= product.category %></span>
      <span class="card-supplier" title="Verified Seller: <%= product.supplierName || 'Shopease Official' %>">
        🏭 <%= product.supplierName ? (product.supplierName.length > 18 ? product.supplierName.substring(0, 16) + '...' : product.supplierName) : 'Official' %>
      </span>
    </div>

    <a href="/product/<%= product.slug %>">
      <h3 class="product-title" title="<%= product.name %>"><%= product.name %></h3>
    </a>

    <div class="product-rating">
      <span class="stars">★ <%= product.ratings ? product.ratings.toFixed(1) : '5.0' %></span>
      <span class="count">(<%= product.numReviews || 0 %>)</span>
    </div>

    <div class="product-pricing">
      <div class="current-price">$<%= product.price.toFixed(2) %></div>
      <% if (product.originalPrice && product.originalPrice > product.price) { %>
        <div class="original-price">$<%= product.originalPrice.toFixed(2) %></div>
      <% } %>
    </div>

    <% if (product.stock > 0) { %>
      <div class="card-cart-action-wrap">
        <div class="card-qty-stepper">
          <button type="button" class="card-qty-btn card-qty-minus" aria-label="Decrease quantity" title="Decrease">-</button>
          <input 
            type="number" 
            class="card-qty-input" 
            id="qty-<%= product._id %>" 
            value="1" 
            min="1" 
            max="<%= product.stock %>"
            data-stock="<%= product.stock %>"
            aria-label="Product quantity"
          >
          <button type="button" class="card-qty-btn card-qty-plus" aria-label="Increase quantity" title="Increase">+</button>
        </div>
        <button 
          class="btn btn-primary btn-sm ajax-add-cart-btn" 
          data-product-id="<%= product._id %>"
          data-product-name="<%= product.name %>"
          data-product-price="<%= product.price %>"
          data-product-original="<%= product.originalPrice || product.price %>"
          data-product-image="<%= product.thumbnail %>"
          data-product-slug="<%= product.slug %>"
          data-product-brand="<%= product.brand %>"
          data-product-stock="<%= product.stock %>"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          Add to Cart
        </button>
      </div>
    <% } else { %>
      <button class="btn btn-outline btn-sm btn-block" disabled style="opacity: 0.6; cursor: not-allowed; background: var(--bg-muted);">
        ✕ Sold Out
      </button>
    <% } %>
  </div>
</div>
